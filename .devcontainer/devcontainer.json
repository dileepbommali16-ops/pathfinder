{
  "name": "Pathfinder Development Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/api.py",
        "client/src/App.tsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "[ -f requirements.txt ] && pip3 install --user -r requirements.txt; [ -f package.json ] && npm install --legacy-peer-deps; echo '✅ Dependencies installed successfully'",
  "postAttachCommand": {
    "backend": "python3 -m uvicorn backend.api:app --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "openPreview"
    },
    "3000": {
      "label": "React Vite Client",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    3000
  ]
}

import os
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from backend.agent.live_proxy import router as agent_ws_router

app = FastAPI(title="PATHFINDER 2.0 Cloud Backend")

FRONTEND_URL = os.getenv("FRONTEND_URL",
"https://pathfinder-client-fzom.vercel.app")

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        FRONTEND_URL,
  "https://pathfinder-client-fzom.vercel.app"
],
    allow_credentials=True,
    allow_methods=[
  "*"
],
    allow_headers=[
  "*"
],
)

# Connect Live Agent WebSocket (/agent/ws)
app.include_router(agent_ws_router)

@app.get("/health")
async def health_check():
    return {
  "status": "online",
  "agent": "DAS 3D Live Co-Pilot",
  "frontend": FRONTEND_URL,
  "websocket": "wss://pathfinder-backend-klrp.onrender.com/agent/ws"
}