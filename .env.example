# ==============================================================================
# Pathfinder 2.0 Environment Configuration
# ==============================================================================

# --- Groq LPU Configuration (Ultra-low latency speech brain: https://console.groq.com) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional free fallback provider (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Deepgram Voice Intelligence (v2 Flux Speech: https://console.deepgram.com) ---
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=flux-donovan-en
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key_here
VITE_DEEPGRAM_MODEL=flux-donovan-en

# --- Voice Session Limits ---
VOICE_MAX_SESSION_MINUTES=15

# --- Backend Server Configuration ---
HOST=0.0.0.0
PORT=8000
BACKEND_URL=https://pathfinder-backend-klrp.onrender.com
BACKEND_PUBLIC_URL=https://pathfinder-backend-klrp.onrender.com
FRONTEND_URL=https://pathfinder-client-fzom.vercel.app

# --- Frontend Client Configuration ---
VITE_API_BASE_URL=https://pathfinder-backend-klrp.onrender.com

# --- Security & Session Tokens ---
JWT_SECRET=change_this_to_a_secure_random_string_32_chars_min

# --- Real OAuth 2.0 Credentials (Google & GitHub) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
