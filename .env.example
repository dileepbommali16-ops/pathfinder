# ==============================================================================
# PATHFINDER 2.0 - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Complete guide for setting up environment variables in Vercel and Render.
# ==============================================================================

# ==============================================================================
# 1. VERCEL PROJECT DASHBOARD (Frontend Client Environment Variables)
# Path: Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# ==============================================================================
# Production Backend API URL
VITE_API_BASE_URL=https://pathfinder-backend-klrp.onrender.com
VITE_BACKEND_URL=https://pathfinder-backend-klrp.onrender.com

# Production Gemini Live WebSocket URL (Render Backend Proxy)
VITE_WS_URL=wss://pathfinder-backend-klrp.onrender.com/agent/ws

# Gemini Live Model & Voice Metadata
VITE_GEMINI_LIVE_MODEL=gemini-3.8-live
VITE_GEMINI_MODEL=gemini-2.0-flash
VITE_GEMINI_VOICE_NAME=Puck

# Supabase Vector Store & Database (Client-Side)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ==============================================================================
# 2. RENDER WEB SERVICE DASHBOARD (Backend FastAPI Environment Variables)
# Path: Render Dashboard -> pathfinder-backend-klrp -> Environment
# ==============================================================================
PORT=10000
HOST=0.0.0.0
PYTHON_VERSION=3.11.9
ENVIRONMENT=production

# URLs
BACKEND_URL=https://pathfinder-backend-klrp.onrender.com
BACKEND_PUBLIC_URL=https://pathfinder-backend-klrp.onrender.com
FRONTEND_URL=https://pathfinder-client-fzom.vercel.app

# Creator / Owner Recognition
OWNER_EMAIL=dileepbommali16@gmail.com,dileep@pathfinder.ai,dileep

# Google AI Studio Gemini API Configurations
# Gold standard for Multimodal Live bidirectional WebSocket streaming + Puck voice + tools
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE_NAME=Puck
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# n8n Cloud Webhook for Google Workspace Automation (Gmail, Calendar, Sheets)
N8N_WEBHOOK_URL=https://dileepdas.app.n8n.cloud/webhook/pathfinder-google-sync

# Supabase RAG Knowledge & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Security & Session Token Encryption
JWT_SECRET=generate_or_paste_a_32_character_random_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Optional: Google & GitHub OAuth Single Sign-On
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
