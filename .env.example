# ==============================================================================
# Pathfinder 2.0 Environment Configuration
# ==============================================================================

# --- AI Agent & LLM Configuration ---
# Google Gemini API key for the AI Placement Coach & Autonomous Agent Tools
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model: gemini-3.8-flash (fallbacks: gemini-3.5-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional free fallback provider (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Backend Server Configuration ---
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000,http://localhost:5173,https://your-vercel-app.vercel.app

# --- Frontend Client Configuration ---
# Base API URL used by the Vite client to connect to FastAPI
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Security & Session Tokens ---
# Secret key used for signing session JWT tokens (generate using `openssl rand -hex 32`)
JWT_SECRET=change_this_to_a_secure_random_string_32_chars_min

# --- Real OAuth 2.0 Credentials (Google & GitHub) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
