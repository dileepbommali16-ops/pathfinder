# ==============================================================================
# Pathfinder 2.0 - Environment Configuration Template
# ==============================================================================
# This template is split into two sections:
# 1) VERCEL (Frontend React Client Dashboard)
# 2) RENDER (Backend FastAPI Dashboard)
# ==============================================================================

# ==============================================================================
# 1. VERCEL DASHBOARD (Frontend Client Environment Variables)
# Copy & paste these keys into your Vercel Project Settings -> Environment Variables:
# ==============================================================================
VITE_API_BASE_URL=https://pathfinder-backend-klrp.onrender.com
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_LIVE_MODEL=gemini-3.8-live
VITE_GEMINI_MODEL=gemini-3.5-flash
VITE_GEMINI_VOICE_NAME=Puck
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==============================================================================
# 2. RENDER DASHBOARD (Backend FastAPI Environment Variables)
# Copy & paste these keys into your Render Web Service -> Environment Variables:
# ==============================================================================
PORT=8000
HOST=0.0.0.0
BACKEND_URL=https://pathfinder-backend-klrp.onrender.com
FRONTEND_URL=https://pathfinder-client-fzom.vercel.app
OWNER_EMAIL=dileepbommali16@gmail.com,dileepbommali16@users.noreply.github.com,dileep@pathfinder.ai,dileep

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE_NAME=Puck
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

N8N_WEBHOOK_URL=https://dileepdas.app.n8n.cloud/webhook/pathfinder-google-sync
JWT_SECRET=your_32_character_jwt_secret_key_here

# Optional OAuth 2.0 Credentials:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
