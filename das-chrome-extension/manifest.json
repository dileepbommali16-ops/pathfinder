{
  "manifest_version": 3,
  "name": "DAS AI — Real Chrome Automation Bridge",
  "version": "1.0.0",
  "description": "Connects Pathfinder 2.0 DAS AI to real Chrome tabs for Programiz multi-language compiling, Google search/click/read automation, tab switching, and Gmail visuals.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://pathfinder-client-fzom.vercel.app/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://www.programiz.com/*",
    "https://www.google.com/*",
    "https://mail.google.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "DAS AI Chrome Automation Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pathfinder-client-fzom.vercel.app/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "bridge-content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
