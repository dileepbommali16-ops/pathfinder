{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*", "types/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,

    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@designcodeio/threeui": ["./client/src/shaders/index.ts"],
      "@designcodeio/threeui/style.css": ["./client/src/shaders/threeui.css"],
      "@designcodeio/threeui/*": ["./client/src/shaders/*"]
    }
  }
}
